import rdflib
import numpy as np
from sklearn.metrics.pairwise import cosine_similarity
import gensim.downloader as api
from gensim.models import KeyedVectors

# Load lightweight embedder (50MB, multilingual-ish)
print("Loading glove-twitter-25...")
embed_model = api.load('glove-twitter-25')  # FastText alternative

# Load TTL
g = rdflib.Graph()
g.parse("data/fmcg_ontology.ttl", format="turtle")

# Extract labels
ontology_labels = [str(o) for s, p, o in g.triples((None, rdflib.RDFS.label, None))]
if not ontology_labels:
    ontology_labels = ["Cooking Oils veg sunflower palm mustard"]  # Fallback
print("Ontology nodes:", ontology_labels)

# Embed function (avg word vecs)
def get_embedding(text):
    words = text.lower().split()
    vecs = [embed_model[word] for word in words if word in embed_model]
    return np.mean(vecs, axis=0) if vecs else np.zeros(25)

ontology_embs = np.array([get_embedding(label) for label in ontology_labels])

def classify(desc, threshold=0.4):
    desc_emb = get_embedding(desc)
    sims = cosine_similarity([desc_emb], ontology_embs)[0]
    best_idx = np.argmax(sims)
    label, score = ontology_labels[best_idx], sims[best_idx]
    status = "✅ PASS" if score > threshold else "⚠️ FALLBACK"
    print(f"Product Description: {desc}")
    print(f"{status}: {label} (sim={score:.3f})")
    return label, score

# Tests
val1 = classify("SuperOil premium mustard oil pure veg family pack")
print("\n")

val2 = classify("Fortune sunflower cooking oil")
print("\n")

val3 = classify("Dabur shampoo")
